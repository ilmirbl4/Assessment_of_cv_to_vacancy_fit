# Переменные docker-compose.yml. Скопируйте в .env (он не коммитится): cp .env.example .env

# --- PostgreSQL ---
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_DB=vacancy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_SHM_SIZE=1gb
# Порт PostgreSQL на хосте (публикуется только на 127.0.0.1, например для pgAdmin)
POSTGRES_HOST_PORT=55433

# --- Бэкенд ---
BACKEND_STORAGE_BACKEND=postgres
BACKEND_ML_BI_ENCODER_PATH=/models/rubert-tiny2
MODELS_DIR=./models
SEED_DEMO_DATA=true
COOKIE_SECURE=false
COLLECTOR_ENABLED=false
PUBLIC_BASE_URL=http://localhost:8080

# --- Почта (Mailpit перехватывает письма) ---
MAILPIT_IMAGE=axllent/mailpit:v1.21
MAILPIT_UI_PORT=8025
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM=noreply@example.com

# --- Фронтенд ---
FRONTEND_PORT=8080
