# Имя проекта Compose и режим запуска. Одна команда: docker compose up -d --build.
COMPOSE_PROJECT_NAME=cvfit

# 1. Локально, новая управляемая БД (по умолчанию):
COMPOSE_FILE=docker-compose.yml:deploy/compose.db.yml:deploy/compose.local.yml
#2. Локально, существующая внешняя БД (в deploy/db.env: DB_MODE=external):
# COMPOSE_FILE=docker-compose.yml:deploy/compose.local.yml
# 3. Сервер: managed БД, HTTPS Caddy и backup:
# COMPOSE_FILE=docker-compose.yml:deploy/compose.db.yml:deploy/compose.server.yml

# dev | production. Production требует HTTPS, secure cookies и ADMIN_PASSWORD >= 12.
APP_ENV=dev

# Внешний адрес клиента; в письмах используется этот же URL.
PUBLIC_BASE_URL=http://localhost:8080
# Локальная публикация только на 127.0.0.1 (server overlay публикует 80/443 через Caddy).
FRONTEND_PORT=8080

# Только для server overlay: реальный домен и контакт ACME.
DOMAIN=example.org
ACME_EMAIL=operator@example.org

# Хостовые каталоги артефактов; внутри контейнера монтируются только для чтения.
MODELS_DIR=./models
DATA_DIR=./data

# Закреплённые образы.
POSTGRES_IMAGE=pgvector/pgvector@sha256:131dcf7ff6a900545df8e7e092c270aa8c6db2f2c818e408cb45ec21316b74e6
CADDY_IMAGE=caddy:2.10.2-alpine
