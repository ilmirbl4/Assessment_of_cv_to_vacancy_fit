COLLECTOR_BATCH_SIZE=32
COLLECTOR_RETRY_S=300
COLLECTOR_OVERLAP_MIN=10
COLLECTOR_MAX_ATTEMPTS=5
COLLECTOR_TICK_S=10
JSON_MAX_BYTES=268435456
TRUDVSEM_BASE_URL=https://opendata.trudvsem.ru/api/v1
