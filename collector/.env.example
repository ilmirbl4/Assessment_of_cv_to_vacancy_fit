# json locally, api on a server
COLLECTOR_SOURCE=json
COLLECTOR_ENABLED=true
INITIAL_VACANCIES_PATH=/data/demo/initial.json
INCREMENTAL_VACANCIES_DIR=/data/input/incremental
COLLECTOR_INCREMENTAL_INTERVAL_MIN=360
COLLECTOR_FULL_RUN_TIME=03:00
