# Container paths; models are mounted read-only. All three exports are mandatory.
ML_MANIFEST_PATH=/models/manifest.json
ML_BI_ENCODER_PATH=/models/USER-bge-m3
ML_NER_PATH=/models/rubert-mini-frida-ner
ML_CROSS_ENCODER_PATH=/models/mmarco-mMiniLMv2-L12-H384-v1
ML_EMBEDDING_DIM=1024
ML_TORCH_THREADS=2
ML_ENCODER_MAX_TOKENS=8192
ML_ENCODER_OVERLAP=64
ML_ENCODER_BATCH_SIZE=2
ML_NER_MAX_TOKENS=512
ML_NER_OVERLAP=128
ML_NER_BATCH_SIZE=8
ML_BATCH_SIZE=32
ML_MAX_PENDING=12
MATCH_RERANK_TOP_N=300
MATCH_PHRASES_PER_REQUIREMENT=5
# Preliminary, not calibrated coverage probabilities
ML_PARTIAL_THRESHOLD=0.45
ML_COVERED_THRESHOLD=0.75
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
