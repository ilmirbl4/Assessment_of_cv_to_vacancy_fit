# managed: host db; external: TCP host (host.docker.internal for Linux host)
DB_MODE=managed
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=vacancies
POSTGRES_USER=vacancies
POSTGRES_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=15
DB_AUTO_MIGRATE=true
DB_HNSW_EF_SEARCH=300
DB_CONNECT_ATTEMPTS=10
DB_CONNECT_RETRY_S=2
